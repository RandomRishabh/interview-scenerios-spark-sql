              {
                "name": "sensorid",
                "type": "long",
                "nullable": true,
                "metadata": {}
              },
              {
                "name": "timestamp",
                "type": "string",
                "nullable": true,
                "metadata": {}
              },
              {
                "name": "values",
                "type": "long",
                "nullable": true,
                "metadata": {}
              }
            ]
          },
          "rows": [
            {
              "sensorid": 1111,
              "timestamp": "2021-01-15",
              "values": 10
            },
            {
              "sensorid": 1111,
              "timestamp": "2021-01-16",
              "values": 15
            },
            {
              "sensorid": 1111,
              "timestamp": "2021-01-17",
              "values": 30
