{
  "id": "3",
  "title": "Differences between consecutive sensor values",
  "slug": "sensor_differences",
  "topic": "Windows",
  "difficulty": "Medium",
  "prompt": "Within each sensorid, order rows by values ascending (values are distinct within a sensor). Replace values with next value minus current value. Keep the current row timestamp and omit the final row per sensor. Input timestamp is a label, not the sort key in this exercise.",
