  "slug": "reverse_words",
  "topic": "String transformations",
  "difficulty": "Easy",
  "prompt": "Reverse characters inside each space-separated word while retaining word order and spaces. Return one column named reverse word. Preserve null and empty strings.",
  "cases": [
