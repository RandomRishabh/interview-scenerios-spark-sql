{
  "id": "24",
  "title": "Ordered navigation paths",
  "slug": "navigation_paths",
  "topic": "Ordered arrays",
  "difficulty": "Medium",
  "prompt": "Return userid and pages, an array of every page visit ordered by event_seq ascending within the user. Retain repeated pages. event_seq is explicitly supplied because Spark DataFrames have no inherent input order; it is unique per user.",
