{
  "id": "9",
  "title": "Participants with the most first places",
  "slug": "most_first_places",
  "topic": "Arrays and aggregation",
  "difficulty": "Medium",
  "prompt": "Count rank=1 occurrences for each participant and return the name column for every participant tied for the largest positive count. If nobody has a first place, return an empty DataFrame. Return a DataFrame even though the reference prints a scalar.",
  "cases": [
    {
      "name": "sample",
      "inputs": {
        "input_df": {
          "kind": "dataframe",
          "schema": {
            "type": "struct",
            "fields": [
              {
                "name": "name",
                "type": "string",
                "nullable": true,
                "metadata": {}
              },
              {
                "name": "rank",
                "type": {
                  "type": "array",
                  "elementType": "long",
                  "containsNull": true
                },
                "nullable": true,
                "metadata": {}
              }
            ]
          },
          "rows": [
            {
              "name": "a",
              "rank": [
                1,
                1,
                1,
                3
              ]
            },
            {
              "name": "b",
              "rank": [
                1,
                2,
                3,
                4
              ]
            },
            {
              "name": "c",
              "rank": [
                1,
                1,
                1,
                1,
                4
              ]
            },
            {
              "name": "d",
              "rank": [
                3
              ]
            }
          ]
        }
      },
      "expected": {
        "kind": "dataframe",
        "schema": {
          "type": "struct",
          "fields": [
            {
              "name": "name",
              "type": "string",
              "nullable": true,
              "metadata": {}
            }
          ]
        },
        "rows": [
          {
            "name": "c"
          }
        ]
      }
    },
