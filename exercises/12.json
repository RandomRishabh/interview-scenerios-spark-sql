{
  "id": "12",
  "title": "Mask contact details",
  "slug": "mask_contacts",
  "topic": "String transformations",
  "difficulty": "Medium",
  "prompt": "Mask each non-null email as its first character + exactly ten asterisks + the substring starting at zero-based index 8. Mask mobile as its first two characters + exactly five asterisks + its last three characters. Preserve nulls. These positional rules intentionally match the original exercise; they are not a production masking policy.",
  "cases": [
